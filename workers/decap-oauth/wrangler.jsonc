{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arjenzhou-decap-oauth",
  "main": "src/index.js",
  "compatibility_date": "2026-06-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "decap-oauth.arjenzhou.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CMS_ORIGIN": "https://arjenzhou.com",
    "CMS_ORIGINS": "https://arjenzhou.com,https://www.arjenzhou.com",
    "GITHUB_OAUTH_SCOPE": "public_repo"
  }
}
